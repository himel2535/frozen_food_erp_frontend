# Backend API — start: cd toys_factory_erp_backend && npm run dev
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Socket.io — same backend origin (not /api/v1). Connects directly; do not proxy through Next.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Default data backend for wired modules (mongodb = Express + MongoDB Atlas)
NEXT_PUBLIC_DATA_BACKEND=mongodb

# Per-module override (optional — wired modules always use mongodb regardless):
# NEXT_PUBLIC_CUSTOMERS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_LEADS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_DEALS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_QUOTATIONS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_SALES_ORDERS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_DELIVERIES_DATA_SOURCE=mongodb
# NEXT_PUBLIC_DISPATCH_DATA_SOURCE=mongodb
# NEXT_PUBLIC_INVOICES_DATA_SOURCE=mongodb
# NEXT_PUBLIC_PAYMENTS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_RETURNS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_POS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_COMPLAINTS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_PRODUCTS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_SUPPLIERS_DATA_SOURCE=mongodb
# NEXT_PUBLIC_EMPLOYEES_DATA_SOURCE=mongodb

# Cloudinary — image uploads (unsigned preset). Required on Vercel too:
# Settings → Environment Variables, then Redeploy. Local npm uses .env.local.
# Production builds also read web/.env.production for these two public keys.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Local API against Atlas from Bangladesh adds RTT on every request.
# For faster `npm run dev`, run the backend with USE_MEMORY_DB=true (npm run dev:memory)
# or a local MongoDB, and keep NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1.
