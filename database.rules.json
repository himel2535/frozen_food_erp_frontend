{
  "rules": {
    ".read": false,
    ".write": false,
    "toysfactory": {
      "auth": {
        "users": {
          ".read": "auth != null && root.child('toysfactory/auth/users').child(auth.uid).child('isMainAdmin').val() == true",
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('toysfactory/auth/users').child(auth.uid).child('isMainAdmin').val() == true)",
            ".write": "auth != null && (root.child('toysfactory/auth/users').child(auth.uid).child('isMainAdmin').val() == true || (auth.uid == $uid && !data.exists()))",
            ".validate": "auth.uid == $uid && !data.exists() ? (!newData.hasChild('isMainAdmin') || newData.child('isMainAdmin').val() == false) : true"
          }
        },
        "roles": {
          ".read": "auth != null && root.child('toysfactory/auth/users').child(auth.uid).child('isMainAdmin').val() == true",
          ".write": "auth != null && root.child('toysfactory/auth/users').child(auth.uid).child('isMainAdmin').val() == true"
        }
      },
      "appState": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
